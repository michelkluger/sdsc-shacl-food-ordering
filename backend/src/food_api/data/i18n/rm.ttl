@prefix food: <https://sdsc.example/ns/food#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

#
# Romansh (rumantsch), in Rumantsch Grischun.
#
# Switzerland's fourth national language, and the one most software quietly omits. It is
# included here because the cost of a language in this design is one file, so leaving it out
# would have been a choice rather than a constraint.
#
# Coverage is honest rather than complete: field labels, group labels and validation messages
# are translated, because those are what a person has to read to fill the form in. Option names
# that are proper nouns fall back through the chain in shacl/introspect.py, which is the
# behaviour that makes partial translation safe. A speaker should review this before it is
# shown to anyone as finished work - see AI_USAGE.md.
#

food:CoreGroup    rdfs:label "Tes plat"@rm .
food:ExtrasGroup  rdfs:label "Supplements"@rm .
food:PickupGroup  rdfs:label "Retratga"@rm .

food:QuantityProperty
    rdfs:label "Quantitad"@rm ;
    sh:description "Quantas porziuns che nus duain preparar."@rm ;
    sh:message "La quantitad sto esser in dumber entir tranter 1 e 10."@rm .

food:CustomerNameProperty
    rdfs:label "Tes num"@rm ;
    sh:description "Il num che nus clamain cur che l'orden è pront."@rm ;
    sh:message "Endatescha per plaschair in num da 2 fin 60 caracters, senza spazis al cumenzament u a la fin."@rm .

food:PickupTimeProperty
    rdfs:label "Ura da retratga"@rm ;
    sh:description "Cura che ti vegns a tour l'orden. Lascha vid per uschè spert sco pussaivel."@rm ;
    sh:message "L'ura da retratga dovra data ed ura, per exempel 2026-09-05T18:30:00+02:00."@rm .

food:CustomerNoteProperty
    rdfs:label "Remartgas per la cuschina"@rm ;
    sh:description "Tut quai che la cuschina duess savair: allergias, picant, pachet."@rm ;
    sh:message "Las remartgas èn limitadas a 280 caracters."@rm .

# ---------------------------------------------------------------------------
# French Tacos
# ---------------------------------------------------------------------------

food:FrenchTacosOrderShape rdfs:label "Orden da tacos franzos"@rm .

food:TacosSizeProperty
    rdfs:label "Grandezza"@rm ;
    sh:description "Grandezza da la tortilla. Tortillas pli grondas tegnan dapli farsa."@rm ;
    sh:message "Tscherna ina grandezza: M, L u XL."@rm .

food:TacosMeatsProperty
    rdfs:label "Charn"@rm ;
    sh:description "Ina u duas. Ina segunda charn dovra ina tortilla XL."@rm ;
    sh:message "Tscherna almain ina charn e maximalmain duas."@rm .

food:TacosSaucesProperty
    rdfs:label "Salsas"@rm ;
    sh:description "Fin a trais salsas. Ellas vegnan maschadadas en la farsa, betg servidas separadamain."@rm ;
    sh:message "Tscherna maximalmain trais salsas."@rm .

food:TacosExtraCheeseProperty
    rdfs:label "Salsa da chaschiel supplementara"@rm ;
    sh:description "Ina segunda cazza da salsa da chaschiel."@rm .

food:TacosSupplementProperty
    rdfs:label "Accumpagnament"@rm ;
    sh:description "Insatge dasperas."@rm .

# ---------------------------------------------------------------------------
# Ramen
# ---------------------------------------------------------------------------

food:RamenOrderShape rdfs:label "Orden da ramen"@rm .

food:RamenBrothProperty
    rdfs:label "Bragl"@rm ;
    sh:description "La basa da la scadiola. Il tonkotsu cuschina deschdotg uras."@rm ;
    sh:message "Tscherna exactamain in bragl."@rm .

food:RamenNoodleFirmnessProperty
    rdfs:label "Cottura dals tagliarins"@rm ;
    sh:description "Quant ditg che ils tagliarins restan en l'aua."@rm ;
    sh:message "Tscherna exactamain ina cottura."@rm .

food:RamenSpiceLevelProperty
    rdfs:label "Grad da picant"@rm ;
    sh:description "0 è mild, 5 na sa emblida betg."@rm ;
    sh:message "Il grad da picant va da 0 fin 5."@rm .

food:RamenToppingsProperty
    rdfs:label "Garniziuns"@rm ;
    sh:description "Fin a tschintg. Chashu ed ajitama n'èn betg disponibels cun in bragl vegan."@rm ;
    sh:message "Tscherna maximalmain tschintg garniziuns."@rm .

food:RamenExtraNoodlesProperty
    rdfs:label "Tagliarins supplementars (kaedama)"@rm ;
    sh:description "Ina segunda porziun da tagliarins, servida uschespert che ti la dumondas."@rm .

# ---------------------------------------------------------------------------
# Poke Bowl
# ---------------------------------------------------------------------------

food:PokeBowlOrderShape rdfs:label "Orden da poke bowl"@rm .

food:PokeBaseProperty
    rdfs:label "Basa"@rm ;
    sh:description "Quai che stat al fund da la scadiola."@rm ;
    sh:message "Tscherna exactamain ina basa."@rm .

food:PokeProteinsProperty
    rdfs:label "Proteina"@rm ;
    sh:description "Ina u duas. Maschadar salm e tun è permess, schizunt recumandà."@rm ;
    sh:message "Tscherna ina u duas proteinas."@rm .

food:PokeDressingProperty
    rdfs:label "Salsa"@rm ;
    sh:description "Vegn versada sur tut la scadiola pauc avant che serrar."@rm ;
    sh:message "Tscherna exactamain ina salsa."@rm .

food:PokeCrunchProperty
    rdfs:label "Croccant"@rm ;
    sh:description "Vegn sprinzlà survart. Fin a trais."@rm ;
    sh:message "Tscherna maximalmain trais elements croccants."@rm .

