# ---------------------------------------------------------------------------
# Cross-field rule messages
# ---------------------------------------------------------------------------

food:TacosTwoMeatsConstraint
    sh:message "Duas charns van mo en ina tortilla XL - tscherna XL, u lascha ina davent."@rm .

food:RamenVeganToppingConstraint
    sh:message "Questa garniziun n'è betg disponibla cun in bragl vegan."@rm .

food:PokeVeganDressingConstraint
    sh:message "Questa salsa n'è betg vegana, mabain tut las proteinas en questa scadiola èn."@rm .

