{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://sdsc.example/ns/food#",
    "food": "https://sdsc.example/ns/food#",
    "schema": "https://schema.org/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "name": {
      "@id": "schema:name",
      "@container": "@language"
    },
    "description": {
      "@id": "schema:description",
      "@container": "@language"
    },
    "cuisine": {
      "@id": "food:cuisine",
      "@container": "@language"
    },
    "basePrice": {
      "@id": "food:basePrice",
      "@type": "xsd:decimal"
    },
    "currency": {
      "@id": "food:currency"
    },
    "image": {
      "@id": "schema:image"
    },
    "tag": {
      "@id": "food:tag",
      "@container": "@set"
    },
    "diet": {
      "@id": "food:diet",
      "@container": "@set"
    },
    "allergen": {
      "@id": "food:containsAllergen",
      "@container": "@set"
    },
    "slug": {
      "@id": "food:slug"
    },
    "dish": {
      "@id": "food:dish",
      "@type": "@vocab"
    }
  }
}
