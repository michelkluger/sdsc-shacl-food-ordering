# Copy to .env (the setup scripts do this for you). .env is gitignored.

# --- Meilisearch ------------------------------------------------------------
# Development-only key. Generate a real one for anything exposed:
#   openssl rand -base64 32
MEILI_MASTER_KEY=devMasterKeyChangeMe
MEILI_ENV=development
MEILI_PORT=7700

# --- Ports ------------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173

# --- API --------------------------------------------------------------------
# Every FOOD_API_* variable maps to a field on food_api.config.Settings.
FOOD_API_DEBUG=false

# Set to true to make an unreachable Meilisearch a hard startup failure instead of
# degrading /api/search to 503.
FOOD_API_REQUIRE_SEARCH=false

# --- Frontend ---------------------------------------------------------------
# Baked into the bundle at build time by Vite.
# Left empty on purpose: the containerised frontend proxies /api through nginx to the api
# service, so the bundle uses same-origin relative URLs and CORS never applies. Set this only
# if you serve the frontend from a different origin than the API.
VITE_API_BASE_URL=
